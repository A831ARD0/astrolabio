# Copia este archivo a .env y rellena lo que haga falta.
#
#   cp .env.ejemplo .env
#
# .env NO se sube al repositorio (está en .gitignore). Guarda las claves en un
# gestor de secretos: si pierdes CLAVE_CIFRADO, las contraseñas de las conexiones
# guardadas no se pueden recuperar.

# --- entorno --------------------------------------------------------------
# 'produccion' hace que el arranque FALLE si faltan las claves de abajo. Es a
# propósito: arrancar con la clave de ejemplo significa que cualquiera puede
# firmarse un token de administrador.
ASTROLABIO_ENTORNO=desarrollo

# --- claves (obligatorias en producción) ----------------------------------
# openssl rand -hex 32
ASTROLABIO_CLAVE_SECRETA=

# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ASTROLABIO_CLAVE_CIFRADO=

# --- dónde viven los datos ------------------------------------------------
# ASTROLABIO_URL_METADATOS=sqlite:////app/datos/astrolabio.db
# ASTROLABIO_RUTA_DUCKDB=/app/analitico/astrolabio.duckdb

# --- sesión y acceso ------------------------------------------------------
# ASTROLABIO_MINUTOS_EXPIRACION_TOKEN=480
# ASTROLABIO_INTENTOS_MAXIMOS=8
# ASTROLABIO_MINUTOS_BLOQUEO=15
# El administrador que se crea en el primer arranque, con contraseña temporal
# que solo aparece en el log de ese arranque.
# ASTROLABIO_CORREO_ADMIN=admin@tuempresa.com

# --- programador ----------------------------------------------------------
# Déjalo encendido en UN SOLO proceso: dos programadores duplican las cargas.
# ASTROLABIO_PROGRAMADOR_ACTIVO=true

# --- avisos por correo ----------------------------------------------------
# Sin SMTP_HOST no se manda nada, y la pantalla lo dice en vez de dejar creer que
# hay cobertura. El canal webhook (Teams, Slack) no necesita nada de esto.
# ASTROLABIO_SMTP_HOST=smtp.tuempresa.com
# ASTROLABIO_SMTP_PUERTO=587
# ASTROLABIO_SMTP_USUARIO=avisos@tuempresa.com
# ASTROLABIO_SMTP_CONTRASENA=
# ASTROLABIO_SMTP_TLS=true
# ASTROLABIO_SMTP_REMITENTE=avisos@tuempresa.com

# Permitir webhooks hacia direcciones de la red interna del servidor. Apagado por
# defecto; las de enlace local (169.254.0.0/16) se rechazan siempre.
# ASTROLABIO_WEBHOOKS_A_RED_INTERNA=false
