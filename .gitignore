# --- secretos y configuración local ---
# Nunca. Lleva las claves con las que se firman los tokens y se cifran las
# credenciales de las conexiones.
.env
*.env
!.env.ejemplo

# --- datos ---
# El directorio entero: metadatos, base analítica y Parquet. Nada de esto se
# publica, y además se regenera con demo/generar_datos.py + demo/sembrar.py.
backend/datos/
*.duckdb
*.duckdb.wal
*.parquet
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- el navegador de los informes ---
# Chromium: unos 300 MB en 600 archivos. No es codigo ni dato del usuario, es una
# herramienta que se descarga con `playwright install`. Desde el instalador va a
# ProgramData, fuera del arbol; esta linea es para las instalaciones que ya lo
# bajaron aqui dentro, para que `git status` no proponga subirlo.
navegador/

# --- Python ---
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Node ---
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*

# --- herramientas y sistema operativo ---
# Contexto de asistentes y editores: no es parte del producto.
.cursor/
.aider*
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- temporales ---
*.tmp
*.bak
*.orig
/tmp/

# Drivers ODBC licenciados (Actian Zen / Pervasive). No se pueden redistribuir:
# ver backend/drivers/README.md. El README de esa carpeta si se versiona.
backend/drivers/*
!backend/drivers/README.md

# Claves generadas por instalar-windows.ps1. Nunca al repositorio.
CLAVES-GENERADAS.txt

# NSSM bajado por instalar-windows.ps1 -DescargarNSSM
herramientas/

# Registros de los servicios de Windows. Los escribe NSSM al lado de la instalacion,
# que es lo normal en un servicio, y crecen solos: no son del producto.
registros/
